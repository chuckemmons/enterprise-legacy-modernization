<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration><session-factory>
  <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
  <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/legacy_cases</property>
  <property name="hibernate.connection.username">legacy_app</property>
  <property name="hibernate.connection.password">CHANGE_ME_ENV_DB_PASSWORD</property>
  <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>
  <property name="hibernate.show_sql">false</property>
  <property name="hibernate.format_sql">true</property>
  <property name="hibernate.hbm2ddl.auto">validate</property>
  <property name="hibernate.connection.pool_size">5</property>
  <mapping resource="mappings/Account.hbm.xml"/>
  <mapping resource="mappings/ServiceCase.hbm.xml"/>
  <mapping resource="mappings/CaseNote.hbm.xml"/>
  <mapping resource="mappings/CaseDocument.hbm.xml"/>
  <mapping resource="mappings/AuditEvent.hbm.xml"/>
  <mapping resource="mappings/CaseNotice.hbm.xml"/>
</session-factory></hibernate-configuration>
