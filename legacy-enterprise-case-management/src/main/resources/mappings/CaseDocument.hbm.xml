<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.example.legacy.model">
 <class name="CaseDocument" table="case_documents" lazy="false">
  <id name="id" type="long" column="id"><generator class="sequence"><param name="sequence">case_documents_id_seq</param></generator></id>
  <property name="caseId" column="case_id" type="long"/>
  <property name="originalName" column="original_name" type="string"/>
  <property name="contentType" column="content_type" type="string"/>
  <property name="contentSize" column="content_size" type="integer"/>
  <property name="payload" column="payload" type="binary"/>
  <property name="uploadedBy" column="uploaded_by" type="string"/>
  <property name="createdAt" column="created_at" type="timestamp"/>
 </class>
</hibernate-mapping>
