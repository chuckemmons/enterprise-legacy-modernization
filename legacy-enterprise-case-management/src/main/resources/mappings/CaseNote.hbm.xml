<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.example.legacy.model">
    <class name="CaseNote" table="case_notes" lazy="false">
        <id name="id" type="long" column="id">
            <generator class="sequence">
                <param name="sequence">case_notes_id_seq</param>
            </generator>
        </id>
        <property name="caseId" type="long" column="case_id" not-null="true"/>
        <property name="author" type="string" column="author" not-null="true" length="60"/>
        <property name="body" type="string" column="body" not-null="true" length="4000"/>
        <property name="createdAt" type="timestamp">
            <column name="created_at" not-null="true" default="now()"/>
        </property>
    </class>

    <query name="CaseNote.findByCaseId"><![CDATA[
        from CaseNote where caseId=:id
        order by createdAt desc
    ]]></query>
</hibernate-mapping>
