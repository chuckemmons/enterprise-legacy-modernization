<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.example.legacy.model">
 <class name="CaseNote" table="case_notes" lazy="false">
  <id name="id" type="long" column="id"><generator class="sequence"><param name="sequence">case_notes_id_seq</param></generator></id>
  <property name="caseId" column="case_id" type="long"/>
  <property name="author" column="author" type="string"/>
  <property name="body" column="body" type="string"/>
  <property name="createdAt" column="created_at" type="timestamp"/>
 </class>
</hibernate-mapping>
