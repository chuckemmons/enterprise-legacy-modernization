<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example.legacy</groupId>
        <artifactId>enterprise-legacy-modernization</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>characterization-tests</artifactId>
    <name>MOD-001 Characterization Tests</name>
    <properties>
        <characterization.database>h2</characterization.database>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.example.legacy</groupId>
            <artifactId>legacy-enterprise-case-management</artifactId>
            <version>${project.version}</version>
            <classifier>classes</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <testResources>
            <testResource>
                <directory>../legacy-enterprise-case-management/src/test/resources</directory>
                <includes><include>h2/schema.sql</include></includes>
            </testResource>
            <testResource>
                <directory>../legacy-enterprise-case-management/db</directory>
                <targetPath>postgresql</targetPath>
                <includes><include>01_schema.sql</include></includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes><exclude>**/*IntegrationTest.java</exclude></excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes><include>**/*IntegrationTest.java</include></includes>
                    <systemPropertyVariables>
                        <characterization.database>${characterization.database}</characterization.database>
                        <characterization.reports>${project.build.directory}/characterization</characterization.reports>
                    </systemPropertyVariables>
                </configuration>
                <executions><execution><goals>
                    <goal>integration-test</goal><goal>verify</goal>
                </goals></execution></executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>characterization-postgresql</id>
            <properties><characterization.database>postgresql</characterization.database></properties>
        </profile>
    </profiles>
</project>
